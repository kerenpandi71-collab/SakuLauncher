{
  "manifest_version": 2,
  "name": "SakuTube Auto Dub Gratis",
  "version": "0.1.0",
  "description": "Menerjemahkan subtitle YouTube ke bahasa Indonesia dan membacakannya dengan TTS perangkat.",
  "applications": { "gecko": { "id": "sakutube-auto-dub@kerenpandi71-collab", "strict_min_version": "109.0" } },
  "permissions": ["storage", "activeTab", "https://www.youtube.com/*", "https://m.youtube.com/*", "https://translate.googleapis.com/*"],
  "browser_action": { "default_title": "SakuTube Auto Dub", "default_popup": "popup.html" },
  "background": { "scripts": ["background.js"], "persistent": false },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }]
}